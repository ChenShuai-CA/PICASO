      "expected_heldout_files": 35
    }
  },
  "scale_ladder": [
    {
      "name": "smoke",
      "waymo_training_shards": 10,
      "interaction_fraction_per_development_location": null,
      "interaction_cap_per_development_location": 2,
      "purpose": "engineering_only"
    },
    {
      "name": "architecture",
