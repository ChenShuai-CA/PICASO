    },
    "gates": {
      "g0": "streaming, hashes, finite arrays, reversible coordinates, zero cross_split groups",
      "g1": "both sources: minADE@6 at least 5 percent below best baseline and paired cluster-bootstrap lower bound above zero; minFDE non-worse; kinematic violation increase at most 1 percentage point",
      "g2": "guided M16 coverage exceeds nominal with paired cluster-bootstrap lower bound above zero; realism degradation at most 5 percent; zero role violations",
      "g3": "K1 and K2 reported separately against strongest equal-budget fixed/random baseline for single and dual",
      "g4": "three seeds, complete manifests, hashes, commands, runtime and dispersion"
